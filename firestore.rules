rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function userProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function userRole(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        ? userProfile(uid).data.role
        : null;
    }

    function ownsOrganization(orgId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)) &&
        (get(/databases/$(database)/documents/organizations/$(orgId)).data.get('firebaseUid', null) == request.auth.uid ||
         get(/databases/$(database)/documents/organizations/$(orgId)).data.get('ownerUid', null) == request.auth.uid);
    }

    function isOrganizationMember(orgId) {
      return signedIn() &&
        currentUserProfile() != null &&
        currentUserProfile().data.role == 'organization' &&
        currentUserProfile().data.organizationId == orgId;
    }

    function currentUserProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid))
        : null;
    }

    function organizationUserForClinic(orgId, clinicId) {
      return currentUserProfile() != null &&
        currentUserProfile().data.role == 'organization' &&
        currentUserProfile().data.organizationId == orgId &&
        (currentUserProfile().data.get('clinicId', null) == null || currentUserProfile().data.get('clinicId', null) == clinicId);
    }

    function matchingOrganizationInvitation(orgId, invitationId) {
      return invitationId is string &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(invitationId)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(invitationId)).data.get('recipientEmail', get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(invitationId)).data.email) == request.auth.token.email &&
        get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(invitationId)).data.role == 'organization' &&
        get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(invitationId)).data.status == 'pending' &&
        (get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(invitationId)).data.get('expiresAt', null) == null || get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(invitationId)).data.expiresAt > request.time);
    }

    function isDoctorOfOrganization(orgId, doctorId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.firebaseUid == request.auth.uid &&
        get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.organizationId == orgId;
    }

    function isPendingDoctorInvitation(orgId, doctorId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId)).data.get('recipientEmail', get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId)).data.email) == request.auth.token.email &&
        get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId)).data.role == 'doctor' &&
        get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId)).data.doctorId == doctorId &&
        get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId)).data.status == 'pending' &&
        (get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId)).data.get('expiresAt', null) == null || get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId)).data.expiresAt > request.time);
    }

    function isDoctorPatientAccess(orgId, doctorId, patientId) {
      return signedIn() &&
        isDoctorOfOrganization(orgId, doctorId) &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)).data.doctorId == doctorId &&
        get(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)).data.organizationId == orgId;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.role in ['patient', 'doctor', 'organization'] &&
        (
          (request.resource.data.role == 'organization' && (
            matchingOrganizationInvitation(request.resource.data.organizationId, request.resource.data.get('invitationId', null)) ||
            (exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)) &&
             get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.firebaseUid == uid &&
             get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.email == request.resource.data.email)
          )) ||
          (request.resource.data.role == 'doctor' &&
           request.resource.data.doctorId is string &&
           exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/doctors/$(request.resource.data.doctorId)) &&
           get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/doctors/$(request.resource.data.doctorId)).data.firebaseUid == uid &&
           get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/doctors/$(request.resource.data.doctorId)).data.organizationId == request.resource.data.organizationId &&
           get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/doctors/$(request.resource.data.doctorId)).data.email == request.resource.data.email) ||
          (request.resource.data.role == 'patient' &&
           request.resource.data.patientId is string &&
           exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/patients/$(request.resource.data.patientId)) &&
           get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/patients/$(request.resource.data.patientId)).data.firebaseUid == uid &&
           get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/patients/$(request.resource.data.patientId)).data.organizationId == request.resource.data.organizationId)
        );

      allow update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.get('doctorId', null) == resource.data.get('doctorId', null) &&
        request.resource.data.get('patientId', null) == resource.data.get('patientId', null) &&
        request.resource.data.get('clinicId', null) == resource.data.get('clinicId', null) &&
        request.resource.data.role in ['patient', 'doctor', 'organization'];

      allow delete: if false;
    }

    match /organizations/{organizationId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.firebaseUid ||
        request.auth.token.email == resource.data.email ||
        (currentUserProfile() != null && currentUserProfile().data.organizationId == organizationId) ||
        isAdmin()
      );

      allow create: if isAdmin() || (signedIn() &&
        request.resource.data.firebaseUid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email);

      allow update: if signedIn() &&
        request.resource.data.email == resource.data.email &&
        (
          (request.auth.uid == resource.data.get('firebaseUid', null) &&
            request.resource.data.get('firebaseUid', null) == resource.data.get('firebaseUid', null)) ||
          (resource.data.get('firebaseUid', null) == null &&
            request.auth.token.email == resource.data.email &&
            request.resource.data.get('firebaseUid', null) == request.auth.uid)
        );

      allow delete: if false;
    }

    match /organizations/{organizationId}/invitations/{invitationId} {
      allow read: if signedIn() && (
        ownsOrganization(organizationId) ||
        (resource.data.get('recipientEmail', resource.data.email) == request.auth.token.email && resource.data.role in ['doctor', 'organization'] && resource.data.status == 'pending') ||
        isAdmin()
      );

      allow create: if signedIn() &&
        ownsOrganization(organizationId) &&
        get(/databases/$(database)/documents/organizations/$(organizationId)).data.status == 'active' &&
        request.resource.data.organizationId == organizationId &&
        request.resource.data.role in ['doctor', 'organization'] &&
        request.resource.data.email is string &&
        request.resource.data.status == 'pending' &&
        request.resource.data.id == invitationId &&
        request.resource.data.invitedBy == request.auth.uid;

      allow update: if signedIn() &&
        ((ownsOrganization(organizationId) || isAdmin()) || (
          resource.data.get('recipientEmail', resource.data.email) == request.auth.token.email &&
          resource.data.role in ['doctor', 'organization'] &&
          resource.data.status == 'pending' &&
          (resource.data.get('expiresAt', null) == null || resource.data.expiresAt > request.time) &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.get('acceptedAt', null) != null
        )) &&
        request.resource.data.organizationId == organizationId &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.invitedBy == resource.data.invitedBy &&
        request.resource.data.doctorId == resource.data.doctorId &&
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.get('clinicId', null) == resource.data.get('clinicId', null);

      allow delete: if signedIn() && (ownsOrganization(organizationId) || isAdmin());
    }

    match /{path=**}/invitations/{invitationId} {
      allow read: if signedIn() &&
        resource.data.get('organizationId', null) is string &&
        resource.data.get('recipientEmail', resource.data.email) == request.auth.token.email &&
        resource.data.role == 'doctor' &&
        resource.data.status == 'pending';
    }

    match /organizations/{organizationId}/doctors/{doctorId} {
      allow read: if signedIn() && (ownsOrganization(organizationId) || isOrganizationMember(organizationId) || isDoctorOfOrganization(organizationId, doctorId) || isPendingDoctorInvitation(organizationId, doctorId) || isAdmin());

      allow create: if signedIn() &&
        ownsOrganization(organizationId) &&
        request.resource.data.organizationId == organizationId &&
        request.resource.data.id == doctorId &&
        request.resource.data.get('firebaseUid', null) == null;

      allow update: if signedIn() &&
        (ownsOrganization(organizationId) || isDoctorOfOrganization(organizationId, doctorId) ||
         (isPendingDoctorInvitation(organizationId, doctorId) &&
          request.resource.data.firebaseUid == request.auth.uid &&
          request.resource.data.status == 'active')) &&
        request.resource.data.organizationId == organizationId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.email == resource.data.email;

      allow delete: if signedIn() && ownsOrganization(organizationId);
    }

    match /organizations/{organizationId}/patients/{patientId} {
      allow read: if signedIn() && (
        ownsOrganization(organizationId) ||
        isOrganizationMember(organizationId) ||
        isDoctorPatientAccess(organizationId, resource.data.doctorId, patientId) ||
        resource.data.get('firebaseUid', null) == request.auth.uid ||
        isAdmin()
      );

      allow create: if signedIn() &&
        isDoctorOfOrganization(organizationId, request.resource.data.doctorId) &&
        request.resource.data.organizationId == organizationId &&
        request.resource.data.id == patientId &&
        request.resource.data.get('firebaseUid', null) == null;

      allow update: if signedIn() && (
        ownsOrganization(organizationId) ||
        (isDoctorOfOrganization(organizationId, resource.data.doctorId) && request.resource.data.doctorId == resource.data.doctorId) ||
        (resource.data.get('firebaseUid', null) == request.auth.uid && request.resource.data.get('firebaseUid', null) == resource.data.get('firebaseUid', null))
      ) && request.resource.data.organizationId == resource.data.organizationId && request.resource.data.id == resource.data.id;

      allow delete: if signedIn() && (ownsOrganization(organizationId) || isAdmin());
    }

    match /organizations/{organizationId}/clinics/{clinicId} {
      allow read: if isAdmin() || (signedIn() && (isOrganizationMember(organizationId) || organizationUserForClinic(organizationId, clinicId)));

      allow create, update: if signedIn() &&
        (isAdmin() || (currentUserProfile() != null && organizationUserForClinic(organizationId, clinicId))) &&
        request.resource.data.organizationId == organizationId;

      allow delete: if isAdmin() || (signedIn() && currentUserProfile() != null && organizationUserForClinic(organizationId, clinicId));
    }

    match /organizations/{organizationId}/appointments/{appointmentId} {
      allow read: if signedIn() && (
        ownsOrganization(organizationId) ||
        isOrganizationMember(organizationId) ||
        (resource.data.doctorId != null && isDoctorOfOrganization(organizationId, resource.data.doctorId)) ||
        (resource.data.get('patientUid', null) == request.auth.uid && exists(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(resource.data.patientId)) && get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(resource.data.patientId)).data.firebaseUid == request.auth.uid && get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(resource.data.patientId)).data.organizationId == organizationId) ||
        isAdmin()
      );

      allow create: if signedIn() &&
        request.resource.data.organizationId == organizationId &&
        request.resource.data.clinicId is string &&
        request.resource.data.doctorId is string &&
        request.resource.data.patientId is string &&
        (request.resource.data.get('patientUid', null) == null || request.resource.data.patientUid is string) &&
        (
        ownsOrganization(organizationId) ||
        (isDoctorOfOrganization(organizationId, request.resource.data.doctorId) && exists(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)) && get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)).data.doctorId == request.resource.data.doctorId && get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)).data.organizationId == organizationId && get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)).data.get('clinicId', null) == request.resource.data.clinicId && exists(/databases/$(database)/documents/organizations/$(organizationId)/clinics/$(request.resource.data.clinicId)) && get(/databases/$(database)/documents/organizations/$(organizationId)/clinics/$(request.resource.data.clinicId)).data.organizationId == organizationId)
      );

      allow update: if signedIn() && (
        ownsOrganization(organizationId) ||
        (isDoctorOfOrganization(organizationId, resource.data.doctorId) &&
         request.resource.data.doctorId == resource.data.doctorId &&
         request.resource.data.patientId == resource.data.patientId &&
         request.resource.data.get('patientUid', null) == resource.data.get('patientUid', null) &&
         request.resource.data.clinicId == resource.data.clinicId)
      ) &&
      request.resource.data.organizationId == organizationId &&
      request.resource.data.patientId == resource.data.patientId &&
      request.resource.data.doctorId == resource.data.doctorId &&
      request.resource.data.clinicId == resource.data.clinicId;

      allow delete: if signedIn() && (ownsOrganization(organizationId) || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
