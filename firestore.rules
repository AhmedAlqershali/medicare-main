rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTHENTICATION & HELPERS
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

        function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isActiveMedicalCatalogEntry(entryId, entryKind) {
      return entryId is string
        && exists(/databases/$(database)/documents/medical_catalog/$(entryId))
        && get(/databases/$(database)/documents/medical_catalog/$(entryId)).data.kind == entryKind
        && get(/databases/$(database)/documents/medical_catalog/$(entryId)).data.active == true
        && get(/databases/$(database)/documents/medical_catalog/$(entryId)).data.archived == false;
    }

    function verifiedEmail() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }

    function userProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function currentUserProfile() {
      return verifiedEmail()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile(request.auth.uid).data.uid == request.auth.uid
        && userProfile(request.auth.uid).data.email == request.auth.token.email
        ? userProfile(request.auth.uid)
        : null;
    }

    function ownsOrganization(orgId) {
      return verifiedEmail()
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && (
          get(/databases/$(database)/documents/organizations/$(orgId)).data.get('firebaseUid', null) == request.auth.uid
          || get(/databases/$(database)/documents/organizations/$(orgId)).data.get('ownerUid', null) == request.auth.uid
        );
    }

    function organizationIsActive(orgId) {
      return exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.status == 'active';
    }

    function ownsActiveOrganization(orgId) {
      return organizationIsActive(orgId) && ownsOrganization(orgId);
    }

    function isOrganizationMember(orgId) {
      return currentUserProfile() != null
        && currentUserProfile().data.role == 'organization'
        && currentUserProfile().data.organizationId == orgId;
    }

    function activeOrganizationMember(orgId) {
      return organizationIsActive(orgId) && isOrganizationMember(orgId);
    }

    function isPatientOfOrganization(orgId) {
      return currentUserProfile() != null
        && currentUserProfile().data.role == 'patient'
        && currentUserProfile().data.organizationId == orgId
        && organizationIsActive(orgId);
    }

    function isCurrentDoctorForOrganization(orgId, doctorId) {
      return currentUserProfile() != null
        && currentUserProfile().data.role == 'doctor'
        && currentUserProfile().data.organizationId == orgId
        && currentUserProfile().data.doctorId == doctorId;
    }

    function organizationUserForClinic(orgId, clinicId) {
      return activeOrganizationMember(orgId)
        && clinicBelongsToOrganization(orgId, clinicId)
        && (
          currentUserProfile().data.get('clinicId', null) == null
          || currentUserProfile().data.get('clinicId', null) == clinicId
        );
    }

    function organizationUserForPatient(orgId, patientId) {
      return activeOrganizationMember(orgId)
        && (
          currentUserProfile().data.get('clinicId', null) == null
          || (
            clinicBelongsToOrganization(
              orgId,
              currentUserProfile().data.clinicId
            )
            && (
              currentUserProfile().data.clinicId
                == patientDocument(orgId, patientId).data.get('clinicId', null)
              || (
                exists(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)/clinic_access_by_clinic/$(currentUserProfile().data.clinicId))
                && get(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)/clinic_access_by_clinic/$(currentUserProfile().data.clinicId)).data.organizationId == orgId
                && get(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)/clinic_access_by_clinic/$(currentUserProfile().data.clinicId)).data.patientId == patientId
                && get(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)/clinic_access_by_clinic/$(currentUserProfile().data.clinicId)).data.clinicId == currentUserProfile().data.clinicId
              )
            )
          )
        );
    }

    function organizationUserForDoctor(orgId, doctorId) {
      return activeOrganizationMember(orgId)
        && exists(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId))
        && (
          currentUserProfile().data.get('clinicId', null) == null
          || (
            clinicBelongsToOrganization(
              orgId,
              currentUserProfile().data.clinicId
            )
            && currentUserProfile().data.clinicId
              == get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.get('clinicId', null)
          )
        );
    }

    function currentDoctorInOrganization(orgId) {
      return currentUserProfile() != null
        && currentUserProfile().data.role == 'doctor'
        && currentUserProfile().data.organizationId == orgId
        && currentUserProfile().data.get('doctorId', null) is string
        && isDoctorOfOrganization(orgId, currentUserProfile().data.doctorId);
    }

    function currentVerifiedDoctor() {
      return currentUserProfile() != null
        && currentUserProfile().data.role == 'doctor'
        && currentUserProfile().data.get('doctorId', null) is string
        && currentUserProfile().data.get('organizationId', null) is string
        && isDoctorOfOrganization(
          currentUserProfile().data.organizationId,
          currentUserProfile().data.doctorId
        );
    }

    function clinicBelongsToOrganization(orgId, clinicId) {
      return clinicId is string
        && exists(/databases/$(database)/documents/organizations/$(orgId)/clinics/$(clinicId))
        && get(/databases/$(database)/documents/organizations/$(orgId)/clinics/$(clinicId)).data.organizationId == orgId
        && (
          get(/databases/$(database)/documents/organizations/$(orgId)/clinics/$(clinicId)).data.get('status', null) == null
          || get(/databases/$(database)/documents/organizations/$(orgId)/clinics/$(clinicId)).data.get('status', null) in ['active', 'نشطة', 'نشط']
        );
    }

    function activeDoctorAssignedToClinic(orgId, doctorId, clinicId) {
      return organizationIsActive(orgId)
        && clinicBelongsToOrganization(orgId, clinicId)
        && exists(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId))
        && get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.organizationId == orgId
        && get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.status == 'active'
        && get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.get('clinicId', null) == clinicId;
    }

    function doctorAssignedToClinic(orgId, clinicId) {
      return currentUserProfile() != null
        && currentUserProfile().data.role == 'doctor'
        && currentUserProfile().data.organizationId == orgId
        && currentUserProfile().data.get('doctorId', null) is string
        && isDoctorOfOrganization(orgId, currentUserProfile().data.doctorId)
        && clinicBelongsToOrganization(orgId, clinicId)
        && get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(currentUserProfile().data.doctorId)).data.get('clinicId', null) == clinicId;
    }

    function patientDocument(orgId, patientId) {
      return get(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId));
    }

    function matchingOrganizationInvitation(orgId, invitationId) {
      return organizationIsActive(orgId)
        && verifiedEmail()
        && invitationId is string
        && exists(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(invitationId))
        && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(invitationId)).data.get(
          'recipientEmail',
          get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(invitationId)).data.email
        ) == request.auth.token.email
        && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(invitationId)).data.role == 'organization'
        && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(invitationId)).data.status == 'pending'
        && (
          get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(invitationId)).data.get('expiresAt', null) == null
          || get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(invitationId)).data.expiresAt > request.time
        );
    }

    function isPendingDoctorInvitation(orgId, doctorId) {
      return verifiedEmail()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId))
        && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId)).data.get(
          'recipientEmail',
          get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId)).data.email
        ) == request.auth.token.email
        && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId)).data.role == 'doctor'
        && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId)).data.doctorId == doctorId
        && get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId)).data.status == 'pending'
        && (
          get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId)).data.get('expiresAt', null) == null
          || get(/databases/$(database)/documents/organizations/$(orgId)/invitations/$(doctorId)).data.expiresAt > request.time
        );
    }

    function isDoctorOfOrganization(orgId, doctorId) {
      return verifiedEmail()
        && currentUserProfile() != null
        && currentUserProfile().data.role == 'doctor'
        && currentUserProfile().data.organizationId == orgId
        && currentUserProfile().data.doctorId == doctorId
        && exists(/databases/$(database)/documents/organizations/$(orgId))
        && get(/databases/$(database)/documents/organizations/$(orgId)).data.status == 'active'
        && exists(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId))
        && get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.firebaseUid == request.auth.uid
        && get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.organizationId == orgId
        && get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.status == 'active';
    }

    function isDoctorPatientAccess(orgId, doctorId, patientId) {
      return signedIn()
        && isDoctorOfOrganization(orgId, doctorId)
        && exists(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId))
        && patientDocument(orgId, patientId).data.organizationId == orgId
        && get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.get('clinicId', null) is string
        && clinicBelongsToOrganization(
          orgId,
          get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.clinicId
        )
        && (
          (
            patientDocument(orgId, patientId).data.doctorId == doctorId
            && (
              patientDocument(orgId, patientId).data.get('clinicId', null) == null
              || patientDocument(orgId, patientId).data.clinicId
                == get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.clinicId
            )
          )
          || (
            exists(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)/clinic_access/$(doctorId))
            && get(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)/clinic_access/$(doctorId)).data.organizationId == orgId
            && get(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)/clinic_access/$(doctorId)).data.patientId == patientId
            && get(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)/clinic_access/$(doctorId)).data.doctorId == doctorId
            && get(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)/clinic_access/$(doctorId)).data.clinicId
              == get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.clinicId
          )
        );
    }

    function isDoctorAppointmentAccess(orgId, doctorId, clinicId) {
      return currentUserProfile() != null
        && currentUserProfile().data.role == 'doctor'
        && currentUserProfile().data.organizationId == orgId
        && currentUserProfile().data.doctorId == doctorId
        && isDoctorOfOrganization(orgId, doctorId)
        && (
          clinicId == null
          || doctorAssignedToClinic(orgId, clinicId)
        );
    }

    function isDoctorAppointmentRecordAccess(orgId, doctorId, patientId, clinicId) {
      return isDoctorAppointmentAccess(orgId, doctorId, clinicId)
        && patientId is string
        && exists(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId))
        && patientDocument(orgId, patientId).data.organizationId == orgId
        && (
          (
            patientDocument(orgId, patientId).data.doctorId == doctorId
            && (
              patientDocument(orgId, patientId).data.get('clinicId', null) == null
              || patientDocument(orgId, patientId).data.get('clinicId', null)
                == get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.get('clinicId', null)
            )
          )
          || (
            exists(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)/clinic_access/$(doctorId))
            && get(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)/clinic_access/$(doctorId)).data.organizationId == orgId
            && get(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)/clinic_access/$(doctorId)).data.clinicId == clinicId
          )
        )
        && (
          (
            clinicId == null
            && get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.get('clinicId', null) is string
            && clinicBelongsToOrganization(
              orgId,
              get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.clinicId
            )
          )
          || (
            clinicId is string
            && clinicBelongsToOrganization(orgId, clinicId)
          )
        );
    }

    function isDoctorCaseAccess(orgId, doctorId, patientId, clinicId) {
      return isDoctorPatientAccess(orgId, doctorId, patientId)
        && clinicId is string
        && clinicBelongsToOrganization(orgId, clinicId)
        && get(/databases/$(database)/documents/organizations/$(orgId)/doctors/$(doctorId)).data.get('clinicId', null) == clinicId
        && (
          patientDocument(orgId, patientId).data.get('clinicId', null) == null
          || patientDocument(orgId, patientId).data.get('clinicId', null) == clinicId
          || (
            exists(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)/clinic_access/$(doctorId))
            && get(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId)/clinic_access/$(doctorId)).data.clinicId == clinicId
          )
        );
    }

    function isCurrentPatientAccess(orgId, patientId) {
      return organizationIsActive(orgId)
        && verifiedEmail()
        && currentUserProfile() != null
        && currentUserProfile().data.role == 'patient'
        && currentUserProfile().data.organizationId == orgId
        && currentUserProfile().data.patientId == patientId
        && exists(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId))
        && patientDocument(orgId, patientId).data.organizationId == orgId
        && patientDocument(orgId, patientId).data.firebaseUid == request.auth.uid
        && patientDocument(orgId, patientId).data.get('accountActivated', false) == true
        && patientDocument(orgId, patientId).data.get('status', null) == 'active';
    }

    function patientEmailMatchesAuthenticatedUser(orgId, patientId) {
      return verifiedEmail()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/patients/$(patientId))
        && patientDocument(orgId, patientId).data.get('email', null) == request.auth.token.email
        && patientDocument(orgId, patientId).data.organizationId == orgId;
    }

    function isPendingPatientActivation(orgId, patientId) {
      return organizationIsActive(orgId)
        && patientEmailMatchesAuthenticatedUser(orgId, patientId)
        && patientDocument(orgId, patientId).data.get('status', null) == 'pending'
        && patientDocument(orgId, patientId).data.get('accountActivated', false) == false
        && patientDocument(orgId, patientId).data.get('firebaseUid', null) == null;
    }

    // ============================================================
    // ADMIN DOCUMENTS
    // ============================================================

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /medical_catalog/{entryId} {
      allow read: if signedIn();

      allow create, update: if isAdmin()
        && request.resource.data.id == entryId
        && request.resource.data.kind in ['specialty', 'condition', 'service']
        && (
          !exists(/databases/$(database)/documents/medical_catalog/$(entryId))
          || request.resource.data.kind == resource.data.kind
        )
        && request.resource.data.nameAr is string
        && request.resource.data.nameEn is string
        && request.resource.data.specialtyIds is list
        && request.resource.data.active is bool
        && request.resource.data.archived is bool
        && (!request.resource.data.archived || !request.resource.data.active)
        && (
          !request.resource.data.keys().hasAny(['repeatIntervalMonths'])
          || (
            request.resource.data.kind == 'service'
            && request.resource.data.repeatIntervalMonths is int
            && request.resource.data.repeatIntervalMonths >= 0
            && request.resource.data.repeatIntervalMonths <= 1200
          )
        )
        && request.resource.data.keys().hasOnly([
          'id', 'kind', 'nameAr', 'nameEn', 'specialtyIds', 'parentId',
          'active', 'archived', 'repeatIntervalMonths', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // ============================================================
    // USERS
    // ============================================================

    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid || isAdmin());

      allow create: if signedIn()
        && request.auth.uid == uid
        && verifiedEmail()
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'role', 'organizationId', 'clinicId',
          'doctorId', 'patientId', 'invitationId', 'createdAt',
          'updatedAt', 'fcmTokens', 'themeMode'
        ])
        && request.resource.data.role in ['patient', 'doctor', 'organization']
        && (
          (
            request.resource.data.role == 'organization'
            && (
              matchingOrganizationInvitation(
                request.resource.data.organizationId,
                request.resource.data.get('invitationId', null)
              )
              && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/invitations/$(request.resource.data.invitationId)).data.get('clinicId', null) == request.resource.data.get('clinicId', null)
              || (
                exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId))
                && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.firebaseUid == uid
                && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.email == request.resource.data.email
              )
            )
          )
          || (
            request.resource.data.role == 'doctor'
            && request.resource.data.doctorId is string
            && exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/doctors/$(request.resource.data.doctorId))
            && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/doctors/$(request.resource.data.doctorId)).data.firebaseUid == uid
            && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/doctors/$(request.resource.data.doctorId)).data.organizationId == request.resource.data.organizationId
            && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/doctors/$(request.resource.data.doctorId)).data.email == request.resource.data.email
            && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/doctors/$(request.resource.data.doctorId)).data.status == 'active'
          )
          || (
            request.resource.data.role == 'patient'
            && request.resource.data.patientId is string
            && request.resource.data.doctorId is string
            && request.resource.data.organizationId is string
            && request.resource.data.email == request.auth.token.email
            && exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/patients/$(request.resource.data.patientId))
            && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/patients/$(request.resource.data.patientId)).data.id == request.resource.data.patientId
            && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/patients/$(request.resource.data.patientId)).data.email == request.resource.data.email
            && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/patients/$(request.resource.data.patientId)).data.firebaseUid == uid
            && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/patients/$(request.resource.data.patientId)).data.accountActivated == true
            && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/patients/$(request.resource.data.patientId)).data.status == 'active'
            && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/patients/$(request.resource.data.patientId)).data.doctorId == request.resource.data.doctorId
            && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)/patients/$(request.resource.data.patientId)).data.organizationId == request.resource.data.organizationId
          )
        );

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && verifiedEmail()
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.get('doctorId', null) == resource.data.get('doctorId', null)
        && request.resource.data.get('patientId', null) == resource.data.get('patientId', null)
        && request.resource.data.get('clinicId', null) == resource.data.get('clinicId', null)
        && request.resource.data.role in ['patient', 'doctor', 'organization']
        && request.resource.data.get('invitationId', null) == resource.data.get('invitationId', null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'themeMode', 'fcmTokens', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // ============================================================
    // ORGANIZATIONS
    // ============================================================

    match /organizations/{organizationId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.get('firebaseUid', null)
        || (verifiedEmail() && request.auth.token.email == resource.data.get('email', null))
        || (
          currentUserProfile() != null
          && currentUserProfile().data.organizationId == organizationId
        )
        || isAdmin()
      );

      allow create: if isAdmin();

      allow update: if isAdmin() || (
        verifiedEmail()
        && request.resource.data.email == resource.data.email
        && request.resource.data.get('ownerUid', null) == resource.data.get('ownerUid', null)
        && (
          (
            request.auth.uid == resource.data.get('firebaseUid', null)
            && request.resource.data.get('firebaseUid', null) == resource.data.get('firebaseUid', null)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'phone', 'location', 'updatedAt'
            ])
          )
          || (
            resource.data.get('firebaseUid', null) == null
            && request.auth.token.email == resource.data.email
            && resource.data.status == 'active'
            && request.resource.data.get('firebaseUid', null) == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'firebaseUid', 'updatedAt'
            ])
          )
        )
      );

      allow delete: if false;
    }

    // ============================================================
    // INVITATIONS
    // ============================================================

    match /organizations/{organizationId}/invitations/{invitationId} {
      allow read: if signedIn() && (
        ownsActiveOrganization(organizationId)
        || (
          verifiedEmail()
          &&
          resource.data.get('recipientEmail', resource.data.email) == request.auth.token.email
          && resource.data.role in ['doctor', 'organization']
          && (
            resource.data.status == 'pending'
            || (
              resource.data.status == 'accepted'
              && resource.data.get('userId', null) == request.auth.uid
            )
          )
        )
        || isAdmin()
      );

      allow create: if signedIn()
        && ownsOrganization(organizationId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)).data.status == 'active'
        && request.resource.data.organizationId == organizationId
        && request.resource.data.role in ['doctor', 'organization']
        && request.resource.data.email is string
        && request.resource.data.status == 'pending'
        && request.resource.data.id == invitationId
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'id', 'email', 'recipientEmail', 'role', 'invitedBy',
          'organizationId', 'status', 'doctorId', 'patientId', 'clinicId',
          'expiresAt', 'userId', 'acceptedAt'
        ])
        && (
          request.resource.data.role != 'doctor'
          || (
            request.resource.data.doctorId == invitationId
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/doctors/$(invitationId)).data.organizationId == organizationId
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/doctors/$(invitationId)).data.email == request.resource.data.email
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/doctors/$(invitationId)).data.get('clinicId', null) == request.resource.data.get('clinicId', null)
          )
        )
        && (
          request.resource.data.get('clinicId', null) == null
          || clinicBelongsToOrganization(
            organizationId,
            request.resource.data.get('clinicId', null)
          )
        );

      allow update: if signedIn()
        && (
          ownsOrganization(organizationId)
          || isAdmin()
          || (
            verifiedEmail()
            && resource.data.get('recipientEmail', resource.data.email) == request.auth.token.email
            && resource.data.role in ['doctor', 'organization']
            && resource.data.status == 'pending'
            && (
              resource.data.get('expiresAt', null) == null
              || resource.data.expiresAt > request.time
            )
            && request.resource.data.status == 'accepted'
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.get('acceptedAt', null) != null
          )
        )
        && request.resource.data.organizationId == organizationId
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.id == resource.data.id
        && request.resource.data.invitedBy == resource.data.invitedBy
        && request.resource.data.get('doctorId', null) == resource.data.get('doctorId', null)
        && request.resource.data.get('patientId', null) == resource.data.get('patientId', null)
        && request.resource.data.get('clinicId', null) == resource.data.get('clinicId', null);

      allow delete: if signedIn()
        && (ownsOrganization(organizationId) || isAdmin());
    }

    match /{path=**}/invitations/{invitationId} {
      allow read: if verifiedEmail()
        && resource.data.get('organizationId', null) is string
        && resource.data.get('recipientEmail', resource.data.email) == request.auth.token.email
        && resource.data.role == 'doctor'
        && resource.data.status == 'pending';
    }

    // ============================================================
    // DOCTORS
    // ============================================================

    match /organizations/{organizationId}/doctors/{doctorId} {
      allow read: if signedIn() && (
        ownsActiveOrganization(organizationId)
        || organizationUserForDoctor(organizationId, doctorId)
        || isPatientOfOrganization(organizationId)
        || isDoctorOfOrganization(organizationId, doctorId)
        || isPendingDoctorInvitation(organizationId, doctorId)
        || isAdmin()
      );

      allow create: if signedIn()
        && ownsOrganization(organizationId)
        && get(/databases/$(database)/documents/organizations/$(organizationId)).data.status == 'active'
        && request.resource.data.organizationId == organizationId
        && request.resource.data.id == doctorId
        && request.resource.data.status == 'pending'
        && request.resource.data.email is string
        && request.resource.data.get('firebaseUid', null) == null
        && (
          request.resource.data.get('specialtyId', null) == null
          || isActiveMedicalCatalogEntry(
            request.resource.data.specialtyId,
            'specialty'
          )
        )
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'email', 'organizationId', 'specialty', 'specialtyId', 'status',
          'initials', 'availability', 'clinic', 'clinicId', 'phone',
          'birthDate', 'gender', 'location', 'rating', 'reviews', 'experience',
          'bio', 'services', 'serviceIds', 'firebaseUid', 'createdAt', 'updatedAt'
        ])
        && (
          request.resource.data.get('clinicId', null) == null
          || clinicBelongsToOrganization(
            organizationId,
            request.resource.data.get('clinicId', null)
          )
        );

      allow update: if signedIn()
        && request.resource.data.organizationId == organizationId
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && (
          request.resource.data.get('specialtyId', null) == null
          || isActiveMedicalCatalogEntry(
            request.resource.data.specialtyId,
            'specialty'
          )
        )
        && (
          (
            isAdmin()
            && request.resource.data.get('firebaseUid', null) == resource.data.get('firebaseUid', null)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'specialty', 'specialtyId', 'status', 'initials', 'availability',
              'clinic', 'clinicId', 'phone', 'birthDate', 'gender', 'location',
              'rating', 'reviews', 'experience', 'bio', 'services', 'serviceIds', 'updatedAt'
            ])
          )
          || (
            ownsActiveOrganization(organizationId)
            && request.resource.data.get('firebaseUid', null) == resource.data.get('firebaseUid', null)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'specialty', 'specialtyId', 'status', 'initials', 'availability',
              'clinic', 'clinicId', 'phone', 'birthDate', 'gender', 'location',
              'rating', 'reviews', 'experience', 'bio', 'services', 'serviceIds', 'updatedAt'
            ])
            && (
              request.resource.data.get('clinicId', null) == null
              || clinicBelongsToOrganization(
                organizationId,
                request.resource.data.get('clinicId', null)
              )
            )
          )
          || (
            currentUserProfile() != null
            && currentUserProfile().data.role == 'doctor'
            && currentUserProfile().data.organizationId == organizationId
            && isDoctorOfOrganization(organizationId, doctorId)
            && request.resource.data.get('firebaseUid', null) == resource.data.get('firebaseUid', null)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'specialty', 'specialtyId', 'initials', 'availability', 'clinic',
              'phone', 'birthDate', 'gender', 'location', 'rating', 'reviews',
              'experience', 'bio', 'services', 'serviceIds', 'updatedAt'
            ])
          )
          || (
            isPendingDoctorInvitation(organizationId, doctorId)
            && get(/databases/$(database)/documents/organizations/$(organizationId)).data.status == 'active'
            && resource.data.get('firebaseUid', null) == null
            && resource.data.status == 'pending'
            && request.resource.data.firebaseUid == request.auth.uid
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'firebaseUid', 'status', 'updatedAt'
            ])
          )
        );

      allow delete: if signedIn()
        && (ownsOrganization(organizationId) || isAdmin());
    }

    // ============================================================
    // PATIENTS
    // ============================================================

    match /organizations/{organizationId}/patients/{patientId} {
      allow read: if signedIn() && (
        ownsActiveOrganization(organizationId)
        || organizationUserForPatient(organizationId, patientId)
        || isDoctorPatientAccess(organizationId, resource.data.doctorId, patientId)
        || isCurrentPatientAccess(organizationId, patientId)
        || isPendingPatientActivation(organizationId, patientId)
        || isAdmin()
      );

      allow create: if false;

      allow update: if signedIn()
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email
        && request.resource.data.doctorId == resource.data.doctorId
        && request.resource.data.get('clinicId', null) == resource.data.get('clinicId', null)
        && (
          (
            isAdmin()
            && request.resource.data.get('firebaseUid', null) == resource.data.get('firebaseUid', null)
            && request.resource.data.get('accountActivated', false) == resource.data.get('accountActivated', false)
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'initials', 'phone', 'birthDate', 'gender', 'notes',
              'problemLocation', 'medicalNotes', 'medicalNotesHistory', 'updatedAt'
            ])
          )
          || (
            ownsActiveOrganization(organizationId)
            && request.resource.data.get('firebaseUid', null) == resource.data.get('firebaseUid', null)
            && request.resource.data.get('accountActivated', false) == resource.data.get('accountActivated', false)
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'initials', 'phone', 'birthDate', 'gender', 'notes',
              'problemLocation', 'medicalNotes', 'medicalNotesHistory', 'updatedAt'
            ])
          )
          || (
            isDoctorPatientAccess(organizationId, resource.data.doctorId, patientId)
            && request.resource.data.get('firebaseUid', null) == resource.data.get('firebaseUid', null)
            && request.resource.data.get('accountActivated', false) == resource.data.get('accountActivated', false)
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'initials', 'phone', 'birthDate', 'gender', 'notes',
              'problemLocation', 'medicalNotes', 'medicalNotesHistory', 'updatedAt'
            ])
          )
          || (
            isCurrentPatientAccess(organizationId, patientId)
            && request.resource.data.get('firebaseUid', null) == resource.data.get('firebaseUid', null)
            && request.resource.data.get('accountActivated', false) == resource.data.get('accountActivated', false)
            && request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'name', 'phone', 'birthDate', 'gender', 'updatedAt'
            ])
          )
          || (
            isPendingPatientActivation(organizationId, patientId)
            && request.resource.data.get('firebaseUid', null) == request.auth.uid
            && request.resource.data.get('accountActivated', false) == true
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'firebaseUid', 'accountActivated', 'status', 'updatedAt'
            ])
          )
          || (
            resource.data.get('firebaseUid', null) == request.auth.uid
            && resource.data.get('accountActivated', false) == true
            && resource.data.status == 'pending'
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'updatedAt'
            ])
          )
        );

      allow delete: if signedIn()
        && (ownsActiveOrganization(organizationId) || isAdmin());
    }

    // Allow a patient to find their pending activation record by email.
    match /{path=**}/patients/{patientId} {
      allow read: if false;
    }

    match /organizations/{organizationId}/patient_email_index/{emailKey} {
      allow get: if isAdmin()
        || ownsActiveOrganization(organizationId)
        || (
          verifiedEmail()
          && request.auth.token.email == emailKey
          && (
            !exists(/databases/$(database)/documents/organizations/$(organizationId)/patient_email_index/$(emailKey))
            || (
              resource.data.organizationId == organizationId
              && resource.data.email == emailKey
              && resource.data.patientId is string
              && exists(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(resource.data.patientId))
              && get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(resource.data.patientId)).data.email == emailKey
            )
          )
        )
        || (
          resource.data.get('patientId', null) is string
          && resource.data.organizationId == organizationId
          && resource.data.email == emailKey
          && currentUserProfile() != null
          && currentUserProfile().data.role == 'doctor'
          && currentUserProfile().data.organizationId == organizationId
          && isDoctorPatientAccess(
            organizationId,
            currentUserProfile().data.get('doctorId', null),
            resource.data.patientId
          )
        );

      allow list: if false;

      allow create: if isAdmin() || (
        verifiedEmail()
        && request.auth.token.email == emailKey
        && request.resource.data.email == emailKey
        && request.resource.data.organizationId == organizationId
        && request.resource.data.patientId is string
        && request.resource.data.keys().hasOnly([
          'email', 'organizationId', 'patientId', 'createdAt'
        ])
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)).data.email == emailKey
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)).data.firebaseUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)).data.accountActivated == true
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.patientId == request.resource.data.patientId
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationId == organizationId
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'patient'
      );

      allow update, delete: if isAdmin();
    }

    match /organizations/{organizationId}/patients/{patientId}/clinic_access/{doctorId} {
      allow read, create, update, delete: if false;
    }

    match /organizations/{organizationId}/patients/{patientId}/clinic_access_by_clinic/{clinicId} {
      allow read, create, update, delete: if false;
    }

    match /patient_email_index/{emailKey} {
      allow get: if isAdmin()
        || ownsActiveOrganization(resource.data.organizationId)
        || (
          resource.data.organizationId is string
          && resource.data.patientId is string
          && resource.data.doctorId is string
          && resource.data.email == emailKey
          && exists(/databases/$(database)/documents/organizations/$(resource.data.organizationId)/patients/$(resource.data.patientId))
          && get(/databases/$(database)/documents/organizations/$(resource.data.organizationId)/patients/$(resource.data.patientId)).data.email == emailKey
          && isDoctorPatientAccess(
            resource.data.organizationId,
            resource.data.doctorId,
            resource.data.patientId
          )
        );

      allow list: if false;

      allow create: if false;

      allow update, delete: if isAdmin();
    }

    // ============================================================
    // PERMANENT MEDICAL NOTES
    // ============================================================

    match /organizations/{organizationId}/patients/{patientId}/medical_notes/{noteId} {
      allow read: if signedIn() && (
        ownsActiveOrganization(organizationId)
        || organizationUserForPatient(organizationId, patientId)
        || (
          currentUserProfile() != null
          && currentUserProfile().data.role == 'doctor'
          && isDoctorPatientAccess(
            organizationId,
            currentUserProfile().data.doctorId,
            patientId
          )
        )
        || isAdmin()
      );

      allow create: if signedIn()
        && currentUserProfile() != null
        && currentUserProfile().data.role == 'doctor'
        && currentUserProfile().data.organizationId == organizationId
        && currentUserProfile().data.get('doctorId', null) is string
        && request.resource.data.doctorUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'text', 'createdAt', 'doctorUid', 'doctorName'
        ])
        && (
          isDoctorPatientAccess(
            organizationId,
            currentUserProfile().data.doctorId,
            patientId
          )
          || (
            isDoctorOfOrganization(
              organizationId,
              currentUserProfile().data.doctorId
            )
            && existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId))
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)).data.organizationId == organizationId
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)).data.doctorId == currentUserProfile().data.doctorId
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)).data.get('clinicId', null)
              == get(/databases/$(database)/documents/organizations/$(organizationId)/doctors/$(currentUserProfile().data.doctorId)).data.get('clinicId', null)
            && clinicBelongsToOrganization(
              organizationId,
              getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)).data.get('clinicId', null)
            )
          )
          || (
            isDoctorOfOrganization(
              organizationId,
              currentUserProfile().data.doctorId
            )
            && existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId))
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)).data.organizationId == organizationId
            && existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/clinic_access/$(currentUserProfile().data.doctorId))
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/clinic_access/$(currentUserProfile().data.doctorId)).data.organizationId == organizationId
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/clinic_access/$(currentUserProfile().data.doctorId)).data.patientId == patientId
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/clinic_access/$(currentUserProfile().data.doctorId)).data.doctorId == currentUserProfile().data.doctorId
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/clinic_access/$(currentUserProfile().data.doctorId)).data.clinicId
              == get(/databases/$(database)/documents/organizations/$(organizationId)/doctors/$(currentUserProfile().data.doctorId)).data.get('clinicId', null)
            && clinicBelongsToOrganization(
              organizationId,
              getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/clinic_access/$(currentUserProfile().data.doctorId)).data.clinicId
            )
          )
        );

      allow update, delete: if false;
    }

    match /organizations/{organizationId}/patients/{patientId}/medical_cases/{caseId} {
      allow read: if signedIn() && (
        isAdmin()
        || ownsActiveOrganization(organizationId)
        || organizationUserForPatient(organizationId, patientId)
        || isDoctorCaseAccess(
          organizationId,
          resource.data.doctorId,
          patientId,
          resource.data.clinicId
        )
        || isCurrentPatientAccess(organizationId, patientId)
      );

      allow create: if signedIn()
        && currentUserProfile() != null
        && currentUserProfile().data.role == 'doctor'
        && currentUserProfile().data.organizationId == organizationId
        && currentUserProfile().data.get('doctorId', null) is string
        && isDoctorCaseAccess(
          organizationId,
          currentUserProfile().data.doctorId,
          patientId,
          request.resource.data.clinicId
        )
        && request.resource.data.id == caseId
        && request.resource.data.patientId == patientId
        && request.resource.data.organizationId == organizationId
        && request.resource.data.doctorId == currentUserProfile().data.doctorId
        && request.resource.data.clinicId is string
        && (
          request.resource.data.clinicId == patientDocument(organizationId, patientId).data.get('clinicId', null)
          || (
            patientDocument(organizationId, patientId).data.get('clinicId', null) == null
            && request.resource.data.clinicId == get(/databases/$(database)/documents/organizations/$(organizationId)/doctors/$(currentUserProfile().data.doctorId)).data.get('clinicId', null)
          )
          || (
            exists(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/clinic_access/$(currentUserProfile().data.doctorId))
            && get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/clinic_access/$(currentUserProfile().data.doctorId)).data.organizationId == organizationId
            && get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/clinic_access/$(currentUserProfile().data.doctorId)).data.clinicId == request.resource.data.clinicId
          )
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && (
          request.resource.data.get('conditionId', null) == null
          || isActiveMedicalCatalogEntry(
            request.resource.data.conditionId,
            'condition'
          )
        )
        && request.resource.data.status == 'active'
        && request.resource.data.startedAt is timestamp
        && request.resource.data.startedAt <= request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.diagnosis is string
        && request.resource.data.assessment is string
        && request.resource.data.notes is string
        && request.resource.data.treatmentPlan is string
        && (
          (
            request.resource.data.type == 'pregnancy'
            && request.resource.data.pregnancy is map
            && request.resource.data.pregnancy.keys().hasOnly([
              'datingMethod', 'referenceDate',
              'gestationalWeeksAtReference', 'gestationalDaysAtReference',
              'expectedDueDate', 'archiveAt'
            ])
            && request.resource.data.pregnancy.datingMethod in [
              'lastMenstrualPeriod',
              'estimatedStartDate',
              'gestationalAgeAtReference'
            ]
            && request.resource.data.pregnancy.referenceDate is timestamp
            && request.resource.data.pregnancy.referenceDate <= request.time
            && request.resource.data.pregnancy.gestationalWeeksAtReference is int
            && request.resource.data.pregnancy.gestationalWeeksAtReference >= 0
            && request.resource.data.pregnancy.gestationalWeeksAtReference <= 42
            && request.resource.data.pregnancy.gestationalDaysAtReference is int
            && request.resource.data.pregnancy.gestationalDaysAtReference >= 0
            && request.resource.data.pregnancy.gestationalDaysAtReference <= 6
            && request.resource.data.pregnancy.gestationalWeeksAtReference * 7
              + request.resource.data.pregnancy.gestationalDaysAtReference <= 294
            && request.resource.data.pregnancy.expectedDueDate is timestamp
            && request.resource.data.pregnancy.archiveAt is timestamp
            && (
              (
                request.resource.data.pregnancy.datingMethod == 'gestationalAgeAtReference'
                && request.resource.data.pregnancy.gestationalWeeksAtReference * 7
                  + request.resource.data.pregnancy.gestationalDaysAtReference > 0
              )
              || (
                request.resource.data.pregnancy.datingMethod in [
                  'lastMenstrualPeriod', 'estimatedStartDate'
                ]
                && request.resource.data.pregnancy.gestationalWeeksAtReference == 0
                && request.resource.data.pregnancy.gestationalDaysAtReference == 0
              )
            )
          )
          || (
            request.resource.data.type != 'pregnancy'
            && !request.resource.data.keys().hasAny(['pregnancy'])
          )
        )
        && request.resource.data.keys().hasOnly([
          'id', 'patientId', 'organizationId', 'doctorId', 'clinicId',
          'title', 'type', 'conditionId', 'startedAt', 'diagnosis', 'assessment', 'notes',
          'treatmentPlan', 'status', 'createdAt', 'pregnancy'
        ]);

      allow update: if signedIn()
        && currentUserProfile() != null
        && currentUserProfile().data.role == 'doctor'
        && currentUserProfile().data.organizationId == organizationId
        && currentUserProfile().data.doctorId == resource.data.doctorId
        && isDoctorCaseAccess(
          organizationId,
          resource.data.doctorId,
          patientId,
          resource.data.clinicId
        )
        && request.resource.data.id == resource.data.id
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.doctorId == resource.data.doctorId
        && request.resource.data.clinicId == resource.data.clinicId
        && request.resource.data.title == resource.data.title
        && request.resource.data.type == resource.data.type
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.diagnosis == resource.data.diagnosis
        && request.resource.data.assessment == resource.data.assessment
        && request.resource.data.notes == resource.data.notes
        && request.resource.data.treatmentPlan == resource.data.treatmentPlan
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'completedAt', 'archivedAt', 'updatedAt', 'pregnancy'
        ])
        && (
          (
            resource.data.status in ['active', 'monitoring']
            && request.resource.data.status == 'monitoring'
            && request.resource.data.updatedAt == request.time
            && request.resource.data.get('pregnancy', null) == resource.data.get('pregnancy', null)
            && request.resource.data.get('completedAt', null) == resource.data.get('completedAt', null)
            && request.resource.data.get('archivedAt', null) == resource.data.get('archivedAt', null)
          )
          || (
            resource.data.status in ['active', 'monitoring']
            && resource.data.type != 'pregnancy'
            && request.resource.data.status == 'completed'
            && request.resource.data.completedAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.get('pregnancy', null) == resource.data.get('pregnancy', null)
            && request.resource.data.get('archivedAt', null) == resource.data.get('archivedAt', null)
          )
          || (
            resource.data.type == 'pregnancy'
            && resource.data.status in ['active', 'monitoring', 'completed']
            && request.resource.data.status == 'completed'
            && request.resource.data.pregnancy is map
            && request.resource.data.pregnancy.keys().hasOnly([
              'datingMethod', 'referenceDate',
              'gestationalWeeksAtReference', 'gestationalDaysAtReference',
              'expectedDueDate', 'archiveAt', 'outcome', 'endedAt'
            ])
            && !resource.data.pregnancy.keys().hasAny(['outcome', 'endedAt'])
            && request.resource.data.pregnancy.datingMethod == resource.data.pregnancy.datingMethod
            && request.resource.data.pregnancy.referenceDate == resource.data.pregnancy.referenceDate
            && request.resource.data.pregnancy.gestationalWeeksAtReference == resource.data.pregnancy.gestationalWeeksAtReference
            && request.resource.data.pregnancy.gestationalDaysAtReference == resource.data.pregnancy.gestationalDaysAtReference
            && request.resource.data.pregnancy.expectedDueDate == resource.data.pregnancy.expectedDueDate
            && request.resource.data.pregnancy.archiveAt == resource.data.pregnancy.archiveAt
            && request.resource.data.pregnancy.outcome in [
              'liveBirth', 'stillbirth', 'miscarriage', 'ectopicPregnancy', 'other'
            ]
            && request.resource.data.pregnancy.endedAt is timestamp
            && request.resource.data.pregnancy.endedAt <= request.time
            && request.resource.data.completedAt == (
              resource.data.status == 'completed'
                ? resource.data.completedAt
                : request.time
            )
            && request.resource.data.updatedAt == request.time
            && request.resource.data.get('archivedAt', null) == resource.data.get('archivedAt', null)
          )
          || (
            resource.data.status in ['active', 'monitoring', 'completed']
            && resource.data.type != 'pregnancy'
            && request.resource.data.status == 'archived'
            && request.resource.data.archivedAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.get('completedAt', null) == resource.data.get('completedAt', null)
          )
        );

      allow delete: if false;
    }

    match /organizations/{organizationId}/patients/{patientId}/medical_cases/{caseId}/follow_ups/{followUpId} {
      allow read: if signedIn()
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/medical_cases/$(caseId))
        && (
          isAdmin()
          || ownsActiveOrganization(organizationId)
          || organizationUserForPatient(organizationId, patientId)
          || isDoctorCaseAccess(
            organizationId,
            get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/medical_cases/$(caseId)).data.doctorId,
            patientId,
            get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/medical_cases/$(caseId)).data.clinicId
          )
          || isCurrentPatientAccess(organizationId, patientId)
        );

      allow create: if signedIn()
        && currentUserProfile() != null
        && currentUserProfile().data.role == 'doctor'
        && currentUserProfile().data.organizationId == organizationId
        && currentUserProfile().data.doctorId == request.resource.data.doctorId
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/medical_cases/$(caseId))
        && get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/medical_cases/$(caseId)).data.status in ['active', 'monitoring']
        && get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/medical_cases/$(caseId)).data.doctorId == request.resource.data.doctorId
        && get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/medical_cases/$(caseId)).data.clinicId == request.resource.data.clinicId
        && request.resource.data.clinicId is string
        && isDoctorCaseAccess(
          organizationId,
          request.resource.data.doctorId,
          patientId,
          request.resource.data.clinicId
        )
        && request.resource.data.id == followUpId
        && request.resource.data.caseId == caseId
        && request.resource.data.patientId == patientId
        && request.resource.data.organizationId == organizationId
        && (
          request.resource.data.clinicId == patientDocument(organizationId, patientId).data.get('clinicId', null)
          || (
            patientDocument(organizationId, patientId).data.get('clinicId', null) == null
            && request.resource.data.clinicId == get(/databases/$(database)/documents/organizations/$(organizationId)/doctors/$(request.resource.data.doctorId)).data.get('clinicId', null)
          )
          || (
            exists(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/clinic_access/$(request.resource.data.doctorId))
            && get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/clinic_access/$(request.resource.data.doctorId)).data.organizationId == organizationId
            && get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId)/clinic_access/$(request.resource.data.doctorId)).data.clinicId == request.resource.data.clinicId
          )
        )
        && request.resource.data.visitAt <= request.time
        && request.resource.data.visitAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.assessment is string
        && request.resource.data.notes is string
        && request.resource.data.recommendations is string
        && request.resource.data.nextPlan is string
        && request.resource.data.caseData is map
        && (
          !request.resource.data.keys().hasAny(['nextAppointmentAt'])
          || (
            request.resource.data.nextAppointmentAt is timestamp
            && request.resource.data.nextAppointmentAt > request.resource.data.visitAt
          )
        )
        && request.resource.data.keys().hasOnly([
          'id', 'caseId', 'patientId', 'organizationId', 'doctorId', 'clinicId',
          'visitAt', 'assessment', 'notes', 'recommendations', 'nextPlan',
          'caseData', 'nextAppointmentAt', 'createdAt', 'appointmentId'
        ])
        && (
          !request.resource.data.keys().hasAny(['appointmentId'])
          || (
            request.resource.data.appointmentId is string
            && request.resource.data.appointmentId.size() > 0
            && exists(/databases/$(database)/documents/organizations/$(organizationId)/appointments/$(request.resource.data.appointmentId))
            && get(/databases/$(database)/documents/organizations/$(organizationId)/appointments/$(request.resource.data.appointmentId)).data.status == 'completed'
            && get(/databases/$(database)/documents/organizations/$(organizationId)/appointments/$(request.resource.data.appointmentId)).data.date is timestamp
            && get(/databases/$(database)/documents/organizations/$(organizationId)/appointments/$(request.resource.data.appointmentId)).data.date <= request.time
            && get(/databases/$(database)/documents/organizations/$(organizationId)/appointments/$(request.resource.data.appointmentId)).data.date.year() == request.resource.data.visitAt.year()
            && get(/databases/$(database)/documents/organizations/$(organizationId)/appointments/$(request.resource.data.appointmentId)).data.date.month() == request.resource.data.visitAt.month()
            && get(/databases/$(database)/documents/organizations/$(organizationId)/appointments/$(request.resource.data.appointmentId)).data.date.day() == request.resource.data.visitAt.day()
            && get(/databases/$(database)/documents/organizations/$(organizationId)/appointments/$(request.resource.data.appointmentId)).data.organizationId == organizationId
            && get(/databases/$(database)/documents/organizations/$(organizationId)/appointments/$(request.resource.data.appointmentId)).data.patientId == patientId
            && get(/databases/$(database)/documents/organizations/$(organizationId)/appointments/$(request.resource.data.appointmentId)).data.doctorId == request.resource.data.doctorId
            && get(/databases/$(database)/documents/organizations/$(organizationId)/appointments/$(request.resource.data.appointmentId)).data.clinicId == request.resource.data.clinicId
          )
        );

      allow update, delete: if false;
    }

    match /organizations/{organizationId}/patients/{patientId}/medical_service_usage/{serviceId} {
      allow read: if signedIn()
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId))
        && (
          isAdmin()
          || ownsActiveOrganization(organizationId)
          || organizationUserForPatient(organizationId, patientId)
          || isCurrentPatientAccess(organizationId, patientId)
          || isDoctorCaseAccess(
            organizationId,
            patientDocument(organizationId, patientId).data.get('doctorId', null),
            patientId,
            patientDocument(organizationId, patientId).data.get('clinicId', null)
          )
        );

      allow create, update, delete: if false;
    }

    match /organizations/{organizationId}/patients/{patientId}/medical_service_history/{recordId} {
      allow read: if signedIn()
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(patientId))
        && (
          isAdmin()
          || ownsActiveOrganization(organizationId)
          || organizationUserForPatient(organizationId, patientId)
          || isCurrentPatientAccess(organizationId, patientId)
          || isDoctorCaseAccess(
            organizationId,
            patientDocument(organizationId, patientId).data.get('doctorId', null),
            patientId,
            patientDocument(organizationId, patientId).data.get('clinicId', null)
          )
        );

      allow create, update, delete: if false;
    }

    match /organizations/{organizationId}/medical_service_override_permissions/{doctorId} {
      allow read: if signedIn() && (
        isAdmin()
        || ownsActiveOrganization(organizationId)
        || isCurrentDoctorForOrganization(organizationId, doctorId)
      );

      allow create, update: if (isAdmin() || ownsActiveOrganization(organizationId))
        && request.resource.data.doctorId == doctorId
        && request.resource.data.permission == 'service_repeat_override'
        && request.resource.data.active is bool
        && request.resource.data.changedBy == request.auth.uid
        && exists(/databases/$(database)/documents/organizations/$(organizationId)/doctors/$(doctorId))
        && request.resource.data.keys().hasOnly([
          'doctorId', 'permission', 'active', 'changedBy', 'updatedAt', 'grantedAt'
        ]);

      allow delete: if false;
    }

    // ============================================================
    // CLINICS
    // ============================================================

    match /organizations/{organizationId}/clinics/{clinicId} {
      allow read: if isAdmin() || (
        signedIn() && (
          organizationUserForClinic(organizationId, clinicId)
          || isPatientOfOrganization(organizationId)
          || doctorAssignedToClinic(organizationId, clinicId)
        )
      );

      allow create: if signedIn()
        && (
          isAdmin()
          || organizationUserForClinic(organizationId, clinicId)
        )
        && request.resource.data.organizationId == organizationId
        && request.resource.data.id == clinicId
        && request.resource.data.keys().hasOnly([
          'id', 'organizationId', 'name', 'location', 'phone', 'description',
          'status', 'doctorsCount', 'departmentsCount', 'patientsCount',
          'departments', 'createdAt', 'updatedAt'
        ]);

      allow update: if signedIn()
        && (isAdmin() || organizationUserForClinic(organizationId, clinicId))
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.organizationId == organizationId
        && request.resource.data.id == resource.data.id
        && request.resource.data.id == clinicId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'location', 'phone', 'description', 'status',
          'doctorsCount', 'departmentsCount', 'patientsCount',
          'departments', 'updatedAt'
        ]);

      allow delete: if isAdmin()
        || organizationUserForClinic(organizationId, clinicId);
    }

    // ============================================================
    // APPOINTMENTS
    // ============================================================

    match /organizations/{organizationId}/appointments/{appointmentId} {
      allow read: if signedIn() && (
        ownsActiveOrganization(organizationId)
        || (
          activeOrganizationMember(organizationId)
          && (
            currentUserProfile().data.get('clinicId', null) == null
            || (
              clinicBelongsToOrganization(
                organizationId,
                currentUserProfile().data.clinicId
              )
              && currentUserProfile().data.clinicId == resource.data.get('clinicId', null)
            )
          )
        )
        || (
          resource.data.get('organizationId', null) == organizationId
          && isDoctorAppointmentRecordAccess(
            organizationId,
            resource.data.get('doctorId', null),
            resource.data.get('patientId', null),
            resource.data.get('clinicId', null)
          )
        )
        || (
          resource.data.get('patientId', null) is string
          &&
          isCurrentPatientAccess(organizationId, resource.data.patientId)
          && resource.data.organizationId == organizationId
          && (
            (
              patientDocument(organizationId, resource.data.patientId).data.doctorId == resource.data.doctorId
              && patientDocument(organizationId, resource.data.patientId).data.get('clinicId', null) == resource.data.get('clinicId', null)
            )
            || (
              exists(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(resource.data.patientId)/clinic_access/$(resource.data.doctorId))
              && get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(resource.data.patientId)/clinic_access/$(resource.data.doctorId)).data.organizationId == organizationId
              && get(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(resource.data.patientId)/clinic_access/$(resource.data.doctorId)).data.clinicId == resource.data.get('clinicId', null)
            )
          )
          && (
            resource.data.get('patientUid', null) == null
            || resource.data.patientUid == request.auth.uid
          )
        )
        || isAdmin()
      );

      allow create: if signedIn()
        && (isAdmin() || organizationIsActive(organizationId))
        && request.resource.data.id == appointmentId
        && request.resource.data.organizationId == organizationId
        && request.resource.data.date is timestamp
        && request.resource.data.date > request.time
        && request.resource.data.status == 'upcoming'
        && request.resource.data.clinicId is string
        && request.resource.data.doctorId is string
        && request.resource.data.patientId is string
        && (
          !request.resource.data.keys().hasAny(['serviceId'])
          || (
            request.resource.data.serviceId is string
            && request.resource.data.serviceName is string
            && isActiveMedicalCatalogEntry(request.resource.data.serviceId, 'service')
            && get(/databases/$(database)/documents/organizations/$(organizationId)/doctors/$(request.resource.data.doctorId)).data.get('serviceIds', []) is list
            && get(/databases/$(database)/documents/organizations/$(organizationId)/doctors/$(request.resource.data.doctorId)).data.get('serviceIds', []).hasAny([request.resource.data.serviceId])
          )
        )
        && request.resource.data.keys().hasOnly([
          'id', 'organizationId', 'clinicId', 'doctorId', 'patientId',
          'patientUid', 'patientName', 'patientInitials', 'age', 'gender',
          'doctorName', 'doctorInitials', 'specialty', 'clinicName', 'location',
          'date', 'time', 'type', 'status', 'notes', 'serviceId', 'serviceName', 'avatarColorValue',
          'createdAt', 'updatedAt', 'createdBy'
        ])
        && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)).data.organizationId == organizationId
        && (
          (
            getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)).data.doctorId == request.resource.data.doctorId
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)).data.get('clinicId', null) == request.resource.data.clinicId
          )
          || (
            existsAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)/clinic_access/$(request.resource.data.doctorId))
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)/clinic_access/$(request.resource.data.doctorId)).data.organizationId == organizationId
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)/clinic_access/$(request.resource.data.doctorId)).data.patientId == request.resource.data.patientId
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)/clinic_access/$(request.resource.data.doctorId)).data.doctorId == request.resource.data.doctorId
            && getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)/clinic_access/$(request.resource.data.doctorId)).data.clinicId == request.resource.data.clinicId
          )
        )
        && clinicBelongsToOrganization(organizationId, request.resource.data.clinicId)
        && activeDoctorAssignedToClinic(
          organizationId,
          request.resource.data.doctorId,
          request.resource.data.clinicId
        )
        && (
          request.resource.data.get('patientUid', null) == null
          || request.resource.data.patientUid == getAfter(/databases/$(database)/documents/organizations/$(organizationId)/patients/$(request.resource.data.patientId)).data.get('firebaseUid', null)
        )
        && (
          ownsActiveOrganization(organizationId)
          || isAdmin()
          || isDoctorAppointmentAccess(
            organizationId,
            request.resource.data.doctorId,
            request.resource.data.clinicId
          )
        );

      allow update: if signedIn()
        && (isAdmin() || organizationIsActive(organizationId))
        && request.resource.data.organizationId == organizationId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.patientId == resource.data.patientId
        && request.resource.data.doctorId == resource.data.doctorId
        && request.resource.data.clinicId == resource.data.clinicId
        && request.resource.data.get('patientUid', null) == resource.data.get('patientUid', null)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'date', 'time', 'type', 'status', 'notes', 'updatedAt'
        ])
        && request.resource.data.get('status', resource.data.status) in [
          'upcoming', 'completed', 'cancelled'
        ]
        && (
          (
            request.resource.data.date == resource.data.date
            && request.resource.data.time == resource.data.time
          )
          || (
            request.resource.data.date is timestamp
            && request.resource.data.date > request.time
            && request.resource.data.get('status', resource.data.status) == 'upcoming'
          )
        )
        && (
          request.resource.data.get('status', resource.data.status) != 'completed'
          || resource.data.status == 'completed'
          || (
            !resource.data.keys().hasAny(['serviceId'])
            &&
            resource.data.date is timestamp
            && resource.data.date <= request.time
            && request.resource.data.date == resource.data.date
          )
        )
        && (
          isAdmin()
          || ownsActiveOrganization(organizationId)
          || isDoctorAppointmentRecordAccess(
            organizationId,
            resource.data.doctorId,
            resource.data.patientId,
            resource.data.get('clinicId', null)
          )
        );

      allow delete: if signedIn()
        && (ownsActiveOrganization(organizationId) || isAdmin());
    }

    // ============================================================
    // ADMIN ACCESS TO ALLOWED NESTED COLLECTIONS
    // ============================================================

    match /organizations/{organizationId}/{collectionName}/{documentId} {
      allow read, create, update, delete: if isAdmin()
        && collectionName in [
          'clinics',
          'doctors',
          'appointments'
        ];
    }

    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}